# GitHub App (Settings → Developer settings → GitHub Apps). Repos are chosen when installing the App.
GITHUB_APP_ID=
# Contents of the App's .pem private key (not a PAT). Multi-line, or on one line with \n escapes
GITHUB_PRIVATE_KEY=
# The App's single webhook secret
GITHUB_WEBHOOK_SECRET=

# LLM provider: anthropic | openai | openai-compatible | gemini
#   openai            = OpenAI's own API (no LLM_BASE_URL)
#   openai-compatible = OpenRouter, Groq, Together, DeepSeek, Ollama, LM Studio… (LLM_BASE_URL required)
LLM_PROVIDER=anthropic
LLM_MODEL=
# Only the gateway reads it: reviewers get a short-lived per-review token instead
LLM_API_KEY=
# Required with openai-compatible (e.g. https://openrouter.ai/api/v1), not allowed with openai, optional otherwise
LLM_BASE_URL=
# Optional: provider-default (default) | none | minimal | low | medium | high | xhigh | max
# "none" for reasoning models that are too slow (e.g. free OpenRouter models)
LLM_REASONING=

# Reviewer container: one throwaway container per review, launched by the worker.
# Image built with `docker compose build reviewer` (never pulled from a registry).
REVIEWER_IMAGE=code-otter-reviewer
# Docker network of the reviewer containers. docker compose creates it as internal (no internet): the
# only way out is the LLM gateway. The worker refuses to start if it isn't internal.
REVIEWER_NETWORK=otter-reviewers

# Signs each review's token for the LLM gateway (shared by worker and gateway). Required, 32+ characters:
#   openssl rand -hex 32
GATEWAY_SECRET=
# Spend limits per review attempt (a retried review gets a fresh budget). Defaults: 150 requests, 3M tokens.
# GATEWAY_REVIEW_MAX_REQUESTS=150
# GATEWAY_REVIEW_MAX_TOKENS=3000000
# Optional emergency brake: tokens per UTC day across all reviews (kept in memory: a gateway restart resets it).
# GATEWAY_DAILY_MAX_TOKENS=

# Reviews run at the same time (default 1; the rest wait in the queue). Each reviewer uses up to 1 GB RAM
# and 1 CPU, and more in parallel means more LLM calls at once (watch provider rate limits).
WORKER_CONCURRENCY=1

# Bearer token for /admin
ADMIN_TOKEN=

# Applied only when the Postgres volume is first created. Use URL-safe characters (e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=otter
# Leave unset: docker-compose builds it from POSTGRES_PASSWORD. Set it only for an external database.
# DATABASE_URL=postgres://otter:<password>@postgres:5432/otter
